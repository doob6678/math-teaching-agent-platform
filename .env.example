# Copy to .env; never commit real provider or Feishu credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MATH_AGENT_DB_NAME=math_agent_rag
# Optional Windows/WSL host port.  Container-to-container traffic remains mysql:3306.
MATH_AGENT_MYSQL_HOST_PORT=3307
MATH_AGENT_REDIS_HOST_PORT=6380
MATH_AGENT_RABBITMQ_HOST_PORT=5673
MATH_AGENT_RABBITMQ_MANAGEMENT_HOST_PORT=15673
MATH_AGENT_MILVUS_HOST_PORT=19531
MATH_AGENT_MILVUS_METRICS_HOST_PORT=9092
MATH_AGENT_WORKER_HOST_PORT=8092
MATH_AGENT_BACKEND_HOST_PORT=8081
MATH_AGENT_FRONTEND_HOST_PORT=5174
MATH_AGENT_WORKER_API_KEY=replace-with-worker-api-key
MATH_AGENT_AGENT_WORKER_SHARED_KEY=replace-with-worker-shared-key
MATH_AGENT_AGENT_WORKER_CAPABILITY_SECRET=replace-with-long-hmac-secret
MATH_AGENT_AGENT_WORKER_DISPATCH_ENABLED=true
MATH_AGENT_AGENT_WORKER_RUNTIME_ENABLED=true
MATH_AGENT_AGENT_WORKER_ID=compose-agent-worker
MATH_AGENT_AGENT_WORKER_MAX_CONCURRENCY=1
MATH_AGENT_MINIO_ACCESS_KEY=minioadmin
MATH_AGENT_MINIO_SECRET_KEY=replace-with-long-minio-secret
MATH_AGENT_MILVUS_ROOT_PASSWORD=replace-with-long-milvus-password
MATH_AGENT_DB_HOST=mysql
MATH_AGENT_DB_PORT=3306
MATH_AGENT_DB_USERNAME=root
# Python writes one immutable event per provider attempt.
MATH_AGENT_AI_PRICES_JSON={"default":{"prompt_per_million":0,"completion_per_million":0}}
# Model weights are mounted read-only. Container paths below must point inside /models.
MATH_AGENT_MODEL_ROOT=./.local-models
# MATH_AGENT_CONTAINER_CLIP_MODEL_PATH=/models/multi-modal_clip-vit-large-patch14_zh
# MATH_AGENT_CONTAINER_RERANK_MODEL_PATH=/models/bge-reranker-v2-m3
# MATH_AGENT_CONTAINER_TEXT_MODEL_PATH=/models/bge-small-zh-v1.5
# OPENAI_API_KEY=required-for-real-generation-and-formula-recognition
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-5.6-luna
MATH_AGENT_AI_CHAT_MAX_OUTPUT_TOKENS=1200
MATH_AGENT_AI_CHAT_REQUEST_TIMEOUT_MS=120000
# Retries apply only before the first provider stream delta, so they cannot duplicate an executed tool call.
MATH_AGENT_AI_CHAT_STREAM_MAX_ATTEMPTS=3
MATH_AGENT_AI_CHAT_RETRY_BASE_DELAY_MS=400
# DASHSCOPE_API_KEY=required-for-real-text-embeddings
MATH_AGENT_EMBEDDING_PROVIDER_ORDER=dashscope
MATH_AGENT_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
MATH_AGENT_EMBEDDING_DIMENSION=512
MATH_AGENT_EMBEDDING_BATCH_SIZE=10
# Enable only when the worker image contains a real CLIP model runtime and MATH_AGENT_CONTAINER_CLIP_MODEL_PATH.
MATH_AGENT_TEACHER_IMAGE_CLIP_ENABLED=false
# MATH_AGENT_TEACHER_SYNC_FEISHU_APPKEY_PATH=/run/secrets/APPKEY.md
# Prefer deployment environment credentials over a local APPKEY file. They are inherited by the Python worker and
# never sent through browser requests, RabbitMQ messages, API responses, or task logs.
# APP_ID=cli_xxxxxxxxxxxxx
# APP_SECRET=keep-this-only-in-the-server-environment
# FEISHU_APP_ID=platform-app-id
# FEISHU_APP_SECRET=platform-app-secret
# The legacy names remain accepted for existing deployments.
# FEISHU_APPID=platform-app-id
# FEISHU_APPSECRET=platform-app-secret
# FEISHU_OAUTH_REDIRECT_URI=https://your-backend.example.com/api/feishu/oauth/callback
# FEISHU_OAUTH_SUCCESS_REDIRECT_URI=https://your-frontend.example.com/
# FEISHU_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Host path mounted read-only into the backend container for textbook retrieval.
MATH_AGENT_PROCESSED_BOOKS_HOST_ROOT=/absolute/path/to/processed_books
FEISHU_OAUTH_SCOPES=drive:drive:readonly drive:drive.metadata:readonly docx:document:readonly
