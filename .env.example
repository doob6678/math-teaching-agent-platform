# Copy this file to .env and replace secret values before a real launch.
# Docker Compose reads .env for interpolation; the Windows launcher reads the same UTF-8 file.
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_BASE_URL=https://api1.aisz.mom/v1
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Local service host ports used by docker-compose.yml.
MATH_AGENT_BACKEND_HOST_PORT=8080
MATH_AGENT_FRONTEND_HOST_PORT=5173
MATH_AGENT_WORKER_HOST_PORT=8092
MATH_AGENT_MYSQL_HOST_PORT=3307
MATH_AGENT_REDIS_HOST_PORT=6380
MATH_AGENT_RABBITMQ_HOST_PORT=5674
MATH_AGENT_RABBITMQ_MANAGEMENT_HOST_PORT=15674
MATH_AGENT_MILVUS_HOST_PORT=19531

# Required local service credentials. Generate deployment-specific values; do not commit .env.
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
MATH_AGENT_WORKER_API_KEY=replace-with-worker-key
MATH_AGENT_AGENT_WORKER_SHARED_KEY=replace-with-agent-worker-key
MATH_AGENT_MINIO_SECRET_KEY=replace-with-minio-secret
MATH_AGENT_MILVUS_ROOT_PASSWORD=replace-with-milvus-root-password

# Host paths mounted read-only by the backend/worker containers.
MATH_AGENT_MODEL_ROOT=/mnt/d/ModelScope/models
MATH_AGENT_PROCESSED_BOOKS_HOST_ROOT=/mnt/c/path/to/processed_books
MATH_AGENT_PDF_FONT_HOST_PATH=/mnt/c/Windows/Fonts/simhei.ttf
