# Copy this file to .env and replace secret values before a real launch.
# Docker Compose reads .env for interpolation; the Windows launcher reads the same UTF-8 file.
# Provider credentials and endpoints are read only by ai-worker; backend receives opaque route metadata and grants.
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_BASE_URL=https://api1.aisz.mom/v1
OPENAI_CHAT_MODEL=gpt-5.6-luna
# GLM 走 Z.ai 的 Anthropic 兼容端点（不是 OpenAI 格式）；凭据只被 ai-worker 读取。
GLM_API_KEY=replace-with-glm-api-key
GLM_BASE_URL=https://api.z.ai/api/anthropic
GLM_CHAT_MODEL=glm-5.3-flash
# glm-5.3-flash 强制思考：low/high/max 三档，弱思考用 low；思考计入 max_tokens，故设可见输出预算下限。
MATH_AGENT_GLM_THINKING_EFFORT=low
MATH_AGENT_GLM_MIN_MAX_TOKENS=2048
MATH_AGENT_PROVIDER_ROUTE_GRANT_SECRET=replace-with-route-grant-secret
# 思考轨迹（reasoning）总开关：true=对可关闭思考的模型全局关闭（默认）；GLM 等强制思考模型无法关闭，
# 其推理内容只落盘到教师侧 model-diagnostics，绝不进入学生可见通道。
MATH_AGENT_WORKER_DISABLE_THINKING=true
# 讲义 JSON 对象输出模式的模型白名单（逗号分隔）；GLM 网关不支持 json_object，适配层自动跳过。
MATH_AGENT_HANDOUT_JSON_OBJECT_MODELS=deepseek-v4-flash
# LaTeX 编译错误回喂模型重写闭环（worker 端 /v1/latex-repair/sync）：provider 顺序，留空沿用讲义顺序。
MATH_AGENT_LATEX_REPAIR_PROVIDERS=
MATH_AGENT_LATEX_REPAIR_TIMEOUT_SECONDS=60
MATH_AGENT_LATEX_REPAIR_MAX_OUTPUT_TOKENS=16000
# 飞书按租户自动建库：父目录 token（留空建在应用云空间根）、租户库文件夹前缀。
FEISHU_LIBRARY_PARENT_TOKEN=
FEISHU_LIBRARY_PREFIX=mathagent
# Java 端模型重写最大轮数（0-3，Spring 属性 math-agent.teaching.latex-repair.max-rounds）。
MATH_AGENT_TEACHING_LATEXREPAIR_MAXROUNDS=1
MATH_AGENT_PROVIDER_OPENAI_ENABLED=true
MATH_AGENT_PROVIDER_DASHSCOPE_ENABLED=false
MATH_AGENT_PROVIDER_DEEPSEEK_ENABLED=false
MATH_AGENT_PROVIDER_ARK_ENABLED=false
MATH_AGENT_PROVIDER_GLM_ENABLED=true
# Optional deployment-owned JSON prices; unknown prices remain -1 while token budgets are still enforced.
# Example: {"openai/gpt-5.6-luna":{"inputPerMillion":1.0,"outputPerMillion":3.0},"glm/glm-5.3-flash":{"inputPerMillion":0.0,"outputPerMillion":0.0}}
MATH_AGENT_AI_PRICES_JSON=
# Production Python handout workers share LangGraph checkpoints/events in MySQL. Use sqlite only for one-process dev.
MATH_AGENT_HANDOUT_CHECKPOINT_BACKEND=mysql
MATH_AGENT_STUDENT_EXPLANATION_CHECKPOINT_BACKEND=mysql
# Fail closed when the worker cannot persist usage before the RabbitMQ task is acknowledged.
MATH_AGENT_USAGE_REQUIRED=true

# Local service host ports used by docker-compose.yml.
MATH_AGENT_BACKEND_HOST_PORT=8080
# Absolute endpoint written to MCP client configuration. Match the actual externally reachable backend address.
MATH_AGENT_MCP_PUBLIC_URL=http://api.mathagent.local/api/mcp
MATH_AGENT_FRONTEND_HOST_PORT=80
MATH_AGENT_WORKER_HOST_PORT=8092
MATH_AGENT_MYSQL_HOST_PORT=3307
MATH_AGENT_REDIS_HOST_PORT=6380
MATH_AGENT_RABBITMQ_HOST_PORT=5674
MATH_AGENT_RABBITMQ_MANAGEMENT_HOST_PORT=15674
MATH_AGENT_MILVUS_HOST_PORT=19531

# Required local service credentials. Generate deployment-specific values; do not commit .env.
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
# The Python AI worker does not receive the MySQL root credential. This account is provisioned by
# scripts/local/provision-ai-runtime-db-user.sh after Flyway creates V32 tables.
MATH_AGENT_AI_RUNTIME_DB_USERNAME=ai_runtime
MATH_AGENT_AI_RUNTIME_DB_PASSWORD=replace-with-32-plus-character-ai-runtime-password
REDIS_PASSWORD=replace-with-redis-password
RABBITMQ_DEFAULT_USER=math-agent
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
MATH_AGENT_FEISHU_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MATH_AGENT_WORKER_API_KEY=replace-with-worker-key
MATH_AGENT_AGENT_WORKER_SHARED_KEY=replace-with-agent-worker-key
MATH_AGENT_MINIO_ACCESS_KEY=replace-with-minio-access-key
MATH_AGENT_MINIO_SECRET_KEY=replace-with-minio-secret
MATH_AGENT_MILVUS_ROOT_PASSWORD=replace-with-milvus-root-password
# Dedicated local-only browser-acceptance identity. It is seeded idempotently by the backend and never sent to the frontend.
MATH_AGENT_LOCAL_ACCEPTANCE_ACCOUNT_ENABLED=true
MATH_AGENT_LOCAL_ACCEPTANCE_ACCOUNT_USERNAME=replace-with-local-acceptance-username
MATH_AGENT_LOCAL_ACCEPTANCE_ACCOUNT_PASSWORD=replace-with-local-acceptance-password
MATH_AGENT_LOCAL_ACCEPTANCE_ACCOUNT_ROLE=admin
MATH_AGENT_LOCAL_ACCEPTANCE_ACCOUNT_TENANT_ID=default

# Managed teacher resource upload root. Keep it separate from Feishu source-imports and teacher-assets.
MATH_AGENT_TEACHER_RESOURCE_UPLOAD_ROOT=/app/data/teacher-resource-uploads

# Container path stored in source_document.local_path; host-side catalog validation maps it to the local staging root.
MATH_AGENT_DB_STAGING_ROOT=/app/data/teacher-source-imports

MATH_AGENT_MODEL_ROOT=/mnt/d/ModelScope/models
MATH_AGENT_PROCESSED_BOOKS_HOST_ROOT=/mnt/c/path/to/processed_books
MATH_AGENT_PDF_FONT_HOST_PATH=/mnt/c/Windows/Fonts/simhei.ttf
MATH_AGENT_GAOKAO_INPUT_HOST_ROOT=/mnt/c/path/to/approved_gaokao_pdfs
# Optional deployment-provided Markdown/image corpus mounted read-only into the backend only. The AI worker receives
# no raw teacher-source mount and can inspect an authorized document only through the run-scoped backend agent tools.
MATH_AGENT_LOCAL_TEACHER_RESOURCES_HOST_ROOT=/mnt/c/Users/doob/Desktop/个人资料/高中数学/下载课本代码/飞书中间下载_md
MATH_AGENT_LOCAL_TEACHER_RESOURCES_ROOT=/app/data/local-teacher-resources
