{
  "schema": "lesson-plan/v1",
  "id": "tangent-angle",
  "title": "一题一课 · 圆外两切线的夹角（2023 新课标Ⅰ卷 T6）",
  "problem": {
    "stem": "过点 $(0,-2)$ 与圆 $x^2+y^2-4x-1=0$ 相切的两条直线的夹角为 $\\alpha$，则 $\\sin\\alpha=$（  ）A. $1$  B. $\\frac{\\sqrt{15}}{4}$  C. $\\frac{\\sqrt{10}}{4}$  D. $\\frac{\\sqrt{6}}{4}$",
    "known": [
      "圆 $x^2+y^2-4x-1=0$，即 $(x-2)^2+y^2=5$",
      "外点 $P(0,-2)$",
      "两切线夹角为 $\\alpha$"
    ],
    "goal": "求 $\\sin\\alpha$",
    "core_observation": "连半径构造直角三角形：切线长 $\\sqrt{3}$，半角正弦余弦易求，倍角公式合成 $\\sin\\angle APB$；$\\angle APB$ 为钝角，$\\alpha$ 与其互补、正弦相同。",
    "answer": "B（$\\frac{\\sqrt{15}}{4}$）"
  },
  "view": {
    "x": [
      -2.6,
      5.6
    ],
    "y": [
      -3.4,
      3.4
    ],
    "axes": true,
    "ticks": {}
  },
  "objects": {
    "C": {
      "type": "point",
      "at": [
        2,
        0
      ],
      "label": "$C(2,0)$"
    },
    "c": {
      "type": "circle",
      "center": "C",
      "radius": 2.2360679
    },
    "P": {
      "type": "point",
      "at": [
        0,
        -2
      ],
      "label": "$P(0,-2)$"
    },
    "A": {
      "type": "tangent_point",
      "from": "P",
      "circle": "c",
      "branch": "ccw",
      "label": "A"
    },
    "B": {
      "type": "tangent_point",
      "from": "P",
      "circle": "c",
      "branch": "cw",
      "label": "B"
    },
    "linePA": {
      "type": "line",
      "from": "P",
      "to": "A",
      "style": "main",
      "extend": 0.22
    },
    "linePB": {
      "type": "line",
      "from": "P",
      "to": "B",
      "style": "main",
      "extend": 0.22
    },
    "segCA": {
      "type": "segment",
      "from": "C",
      "to": "A",
      "style": "aux"
    },
    "segCB": {
      "type": "segment",
      "from": "C",
      "to": "B",
