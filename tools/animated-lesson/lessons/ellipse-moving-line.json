        },
        {
          "op": "caption",
          "text": "让直线绕定点 $(0,-\\frac{3}{2})$ 旋转，观察 $\\angle PTQ$"
        },
        {
          "op": "trace_line",
          "pivot": [
            0,
            -1.5
          ],
          "conic": {
            "a": 3.4641,
            "b": 3,
