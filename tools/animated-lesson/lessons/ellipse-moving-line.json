          ],
          "run_time": 6.5
        }
      ]
    },
    {
      "id": "ch5",
      "title": "结论",
      "subtitle": "直径圆内判定，落定范围",
      "narration": "把点乘条件翻译成 T 在以 PQ 为直径的圆内，对一切实线恒成立，解得 t 的范围是负三到二分之三。存在这样的 T，答案落定。",
      "steps": [
        {
          "op": "caption",
          "text": "$TP\\cdot TQ\\le 0$ 恒成立，当且仅当 $T$ 在以 $PQ$ 为直径的圆内"
        },
        {
          "op": "note",
          "text": "对一切实线恒成立 → $t$ 的范围"
        },
        {
          "op": "answer",
          "text": "-3 \\le t \\le \\frac{3}{2}"
        }
      ]
    }
