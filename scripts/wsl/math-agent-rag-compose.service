[Unit]
Description=Math Agent RAG Compose owner
After=docker.service
Requires=docker.service
Conflicts=math-agent-rag-compose-user.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/c/Users/doob/Desktop/code/dev/math_agent_rag
# This is the only canonical owner. It starts existing containers without recreation and then exits successfully.
ExecStart=/usr/bin/flock -n /run/math-agent-rag-compose.lock /usr/bin/docker compose --env-file .env up -d --no-recreate
# No ExecStop: stopping the owner never stops or deletes containers.

[Install]
WantedBy=multi-user.target
